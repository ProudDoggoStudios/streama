# Hostname pointing at this server (A/AAAA record -> public IP).
# Leave empty (or comment out) to serve plain HTTP on the IP while trying it out.
STREAMA_DOMAIN=

# Mux credentials: videos are uploaded to and streamed from Mux, so this server stores
# no video files. Create an access token at https://dashboard.mux.com/settings/access-tokens
# and paste its Token ID and Secret Key here — or leave these empty and enter them on the
# app's Settings page instead (they are then kept in the database).
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
